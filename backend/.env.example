# Execução local
NODE_ENV=development
PORT=3000

# Endereço do frontend local
FRONTEND_URL=http://localhost:5173
ADDITIONAL_FRONTEND_URLS=

# Proxy e cookie
TRUST_PROXY_HOPS=1
COOKIE_SAME_SITE=lax

# Banco de dados
DATABASE_URL=
DIRECT_URL=

# Sessão
JWT_SECRET=

# Inteligência artificial
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Catálogo de livros
GOOGLE_BOOKS_API_KEY=

# Envio de e-mails
RESEND_API_KEY=
RESEND_FROM_EMAIL="LiterIA <nao-responda@mail.literia.tech>"