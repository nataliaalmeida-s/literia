# Execução
NODE_ENV=production
PORT=3000

# Frontend publicado
FRONTEND_URL=https://SEU-PROJETO.vercel.app
ADDITIONAL_FRONTEND_URLS=

# Render/proxy
TRUST_PROXY_HOPS=1

# Vercel e Render usam domínios diferentes
COOKIE_SAME_SITE=none

# Banco Neon
DATABASE_URL=
DIRECT_URL=

# Sessão
JWT_SECRET=

# Inteligência artificial
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Catálogo de livros
GOOGLE_BOOKS_API_KEY=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL="LiterIA <nao-responda@mail.literia.tech>"